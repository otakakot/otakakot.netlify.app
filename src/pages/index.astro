---
import { Image } from 'astro:assets';
import '../styles/index.css';
import part1 from '../assets/gopher-part-1.png';
import part2 from '../assets/gopher-part-2.png';
import part3 from '../assets/gopher-part-3.png';
import part4 from '../assets/gopher-part-4.png';

const gopherParts = [part1, part2, part3, part4];
const parts = Array.from({ length: 18 }, (_, index) => ({
	src: gopherParts[index % gopherParts.length],
	size: 125 + ((index * 29) % 64),
}));
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Netlify Identity のログイン" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>ログイン | otakakot</title>
	</head>
	<body>
		<div class="background-parts" aria-hidden="true">
			{
				parts.map((part) => (
					<Image
						class="part"
						src={part.src}
						alt=""
						width={part.size}
						height={Math.round((part.size * 382) / 380)}
						format="webp"
						quality={75}
						loading="eager"
						decoding="async"
						style={`width:${part.size}px;height:auto`}
					/>
				))
			}
		</div>
		<script is:inline>
			const columns = 6;
			const rows = 3;
			document.querySelectorAll('.background-parts .part').forEach((image, index) => {
				image.style.left = `${(((index % columns) + Math.random()) / columns) * 100}%`;
				image.style.top = `${((Math.floor(index / columns) + Math.random()) / rows) * 100}%`;
			});
		</script>
		<div class="center">
			<div class="stack">
				<main>
					<section id="signed-out">
						<form id="login-form">
							<label>
								メールアドレス
								<input name="email" type="email" autocomplete="username" required />
							</label>
							<label>
								パスワード
								<input name="password" type="password" autocomplete="current-password" required />
							</label>
							<button id="login" type="submit">ログイン</button>
							<p id="message" role="status" aria-live="polite"></p>
						</form>
					</section>
					<section id="signed-in" hidden>
						<h2>ログイン済み</h2>
						<p><span id="user-email"></span> としてログインしています。</p>
						<button id="logout" type="button">ログアウト</button>
					</section>
					<section id="accept-invite" hidden>
						<h2>招待を承認</h2>
						<p>招待されたアカウントのパスワードを設定してください。</p>
						<form id="invite-form">
							<label>
								パスワード
								<input name="password" type="password" autocomplete="new-password" minlength="8" required />
							</label>
							<button id="accept" type="submit">パスワードを設定</button>
							<p id="invite-message" role="status" aria-live="polite"></p>
						</form>
					</section>
				</main>
				<p class="credit">The <a href="https://go.dev/blog/gopher" target="_blank" rel="noopener noreferrer">Go gopher</a> was designed by <a href="https://reneefrench.blogspot.com/" target="_blank" rel="noopener noreferrer">Renée French</a>.</p>
			</div>
		</div>
		<script src="../scripts/index.ts"></script>
	</body>
</html>
